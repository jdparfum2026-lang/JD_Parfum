# =============================================================================
# JD Parfum — isolated credentials
# Copy to .env for local. On Render: Environment → paste the same keys.
# Do NOT copy live AmirCars secrets (amircars.onrender.com / AmirCars Supabase /
# AmirCars Cloudinary). Create NEW JD project / cloud / service values only.
# =============================================================================

# --- Required (app will not boot without these) ---
FLASK_SECRET_KEY=replace_with_64_byte_hex_jd_parfum_only
SUPABASE_URL=https://YOUR_JD_PARFUM_PROJECT.supabase.co
# Dashboard → Project Settings → API → anon / publishable key
SUPABASE_KEY=sb_publishable_replace_me_jd_parfum

# --- Cloudinary: use ONE of the two styles (not mismatched placeholders) ---
# Style A (preferred on Render if you paste the full URL from the console):
CLOUDINARY_URL=cloudinary://JD_API_KEY:JD_API_SECRET@JD_CLOUD_NAME
# Style B (leave CLOUDINARY_URL empty / unset and set all three):
# CLOUDINARY_CLOUD_NAME=jd_parfum_cloud
# CLOUDINARY_API_KEY=jd_api_key_digits
# CLOUDINARY_API_SECRET=jd_api_secret

# --- Optional ---
# Server-only. Prefer sql/006_public_catalog_anon.sql so anon can read the catalog.
SUPABASE_SERVICE_ROLE_KEY=

# --- Render / production defaults (already set in render.yaml) ---
FLASK_DEBUG=0
FORCE_HTTPS=true
COOKIE_SECURE=true
WEB_CONCURRENCY=1
# PYTHON_VERSION=3.12.7

# Render web service name: jd-parfum
# Health check: GET /api/health  → cloudinary true when Cloudinary env is valid
